{
  "name": "householdr",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "build": "pnpm --recursive build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc && pnpm --recursive typecheck",
    "test": "vitest run",
    "flags:check": "node scripts/check-flag-expiry.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
