{
  "name": "@householdr/web",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "prepare": "paraglide-js compile --project ../../project.inlang --outdir ./src/lib/paraglide && svelte-kit sync",
    "typecheck": "pnpm prepare && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@householdr/adapters": "workspace:*",
    "@householdr/application": "workspace:*",
    "@householdr/auth": "workspace:*",
    "@householdr/domain": "workspace:*",
    "@internationalized/date": "catalog:",
    "@opentelemetry/api": "catalog:",
    "bits-ui": "catalog:",
    "cn": "catalog:",
    "tailwind-variants": "catalog:",
    "uqr": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
