{
  "name": "@householdr/worker",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm prepare && vite build",
    "prepare": "paraglide-js compile --project ../../project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --emit-ts-declarations --silent",
    "typecheck": "pnpm prepare && tsc"
  },
  "dependencies": {
    "@householdr/adapters": "workspace:*",
    "@householdr/application": "workspace:*",
    "@householdr/auth": "workspace:*"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:"
  }
}
