# Householdr configuration.
#
# All configuration comes from environment variables (ADR-0008 §13, ADR-0021 §4).
# Copy this file to .env and fill in your own values. Never commit .env.
# Every value below is a placeholder. Names may still change before the first release.

# --- Web app -----------------------------------------------------------------
# The public URL people use to reach this instance, without a trailing slash.
ORIGIN=https://householdr.example.org
PORT=3000

# --- Database (PostgreSQL) -----------------------------------------------------
DATABASE_URL=postgres://householdr:change-me@localhost:5432/householdr

# --- Secrets -------------------------------------------------------------------
# Generate each with: openssl rand -base64 32
SESSION_SECRET=change-me
# Encrypts TOTP secrets. Versioned so it can be rotated (ADR-0017 §7):
# add a new version, make it current, keep the old one until it is no longer used.
TOTP_ENCRYPTION_KEYS=1:change-me
TOTP_ENCRYPTION_KEY_CURRENT=1

# --- E-mail (SMTP) -------------------------------------------------------------
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
MAIL_FROM="Householdr <householdr@example.org>"

# --- Web Push (VAPID) ----------------------------------------------------------
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.org

# --- Breached-password check (ADR-0010 §2) -------------------------------------
# Queries Have I Been Pwned's range API. Set to false on instances without outbound access.
BREACHED_PASSWORD_CHECK=true

# --- Feature flags (optional, ADR-0015) ----------------------------------------
# Leave empty to run without Flipt: every flag then takes its registry default.
FLIPT_URL=
FLIPT_CLIENT_TOKEN=

# --- Product events (ADR-0015 §8, ADR-0021 §5) ---------------------------------
# Off by default. Nothing is ever sent to the Householdr project; events stay in your own database.
PRODUCT_EVENTS=false
