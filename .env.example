# Householdr configuration.
#
# All configuration comes from environment variables (ADR-0008 §13, ADR-0021 §4).
# Copy this file to .env and fill in your own values. Never commit .env.
# Every value below is a placeholder. Names may still change before the first release.

# --- Web app -----------------------------------------------------------------
# The public URL people use to reach this instance, without a trailing slash. Passkeys belong to
# its host name: change it later, and every passkey stops working.
ORIGIN=https://householdr.example.org
PORT=3000
# Behind a reverse proxy, the header it puts the visitor's IP address in, and how many proxies sit
# in front. Failed sign-ins are counted per address (ADR-0010 §2); without these, everyone would
# share the proxy's address. Leave both empty when nothing sits in front.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# --- Database (PostgreSQL) -----------------------------------------------------
# The role the app and the worker connect as: it reads and writes data, and row-level security
# binds it. Another role owns the tables and runs the migrations, which grant this one its rights.
# The app refuses the owner, a superuser or a role with BYPASSRLS, since row-level security
# wouldn't bind them (ADR-0008 §9, clarification).
DATABASE_URL=postgres://householdr_app:change-me@localhost:5432/householdr

# --- Secrets -------------------------------------------------------------------
# Generate each with: openssl rand -base64 32
SESSION_SECRET=change-me
# Encrypts the secrets of two-factor authenticator apps and the recovery codes, as version:key,
# separated by commas. Versioned so it can be rotated (ADR-0017 §7): add a new version, make it
# current, keep the old one until it is no longer used. Set both or neither; without them,
# two-factor can't be turned on.
TOTP_ENCRYPTION_KEYS=1:change-me
TOTP_ENCRYPTION_KEY_CURRENT=1

# --- E-mail (SMTP) -------------------------------------------------------------
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
MAIL_FROM="Householdr <householdr@example.org>"
# Sending stops unless the connection to the SMTP server is encrypted. Set to false only for a
# local test server, such as Mailpit.
SMTP_REQUIRE_TLS=true

# --- Web Push (VAPID) ----------------------------------------------------------
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.org

# --- Breached-password check (ADR-0010 §2) -------------------------------------
# Queries Have I Been Pwned's range API. Set to false on instances without outbound access.
BREACHED_PASSWORD_CHECK=true

# --- Terms (optional, ADR-0021 §5) ---------------------------------------------
# A link to this instance's own terms, and their version. Someone creating a household, or an account
# through an invitation, is asked to accept them, and their account keeps the version and when
# (ADR-0007 §2, ADR-0010 §1, ADR-0012 §2). Set both or neither: without them, nobody is asked about
# terms. Our hosted service sets both for its terms.
TERMS_URL=
TERMS_VERSION=

# --- Feature flags (optional, ADR-0015) ----------------------------------------
# Leave empty to run without Flipt: every flag then takes its registry default.
FLIPT_URL=
FLIPT_CLIENT_TOKEN=
# The Flipt v2 environment to read flags from; empty for Flipt's default environment.
FLIPT_ENVIRONMENT=

# --- Product events (ADR-0015 §8, ADR-0021 §5) ---------------------------------
# Off by default. Nothing is ever sent to the Householdr project; events stay in your own database.
PRODUCT_EVENTS=false
